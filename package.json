{
  "name": "shopnest",
  "version": "1.0.0",
  "author": "Shivansh Vasu",
  "description": "Full-Stack MERN E-Commerce App",
  "scripts": {
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": " npm install && npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend",
    "start": "node backend/server.js",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm --prefix backend run dev",
    "start:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "client": "npm run dev --prefix frontend",
    "server": "npm run dev --prefix backend"
    
  
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShivaMani02/shopnest-ecom-MERN.git"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ShivaMani02/shopnest-ecom-MERN/issues"
  },
  "homepage": "https://github.com/ShivaMani02/shopnest-ecom-MERN#readme",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
